{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "rootDir": ".",
    "outDir": "dist",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": true,
    "types": ["node"]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/node_modules/*"
  ],
}